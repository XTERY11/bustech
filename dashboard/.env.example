DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=20000
# Default: local-only bridge. For LAN use, supply a separate bridge token.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
DASHBOARD_PORT=3000
NEXT_PUBLIC_VISION_PORT=8790
BRIDGE_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Static GitHub Pages can point to an independently hosted HTTPS bridge.
NEXT_PUBLIC_API_BASE_URL=
